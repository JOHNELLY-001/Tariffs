# CET Tariff Backend — environment template
# Copy to .env.local (or .env) and fill in real values. NEVER commit credentials.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Neon pooled endpoint recommended).
# Required in production; the API returns 503 until it is set.
#
# TLS guidance (forward-compatible with pg v9 / pg-connection-string v3):
#   - Prefer:  ?sslmode=verify-full   (current, strict behaviour)
#   - Or omit sslmode entirely and let DATABASE_SSL_VERIFY govern verification.
#   - Avoid plain `sslmode=require`: in pg v9 it will adopt libpq's weaker
#     semantics (encrypt but do not verify the server certificate).
#   - `sslmode=disable` is honoured as an explicit opt-out.
DATABASE_URL=

# TLS for the database connection (keep true outside local development).
DATABASE_SSL=true

# Verify the server certificate chain and hostname (recommended: true).
# Set to false only when you cannot supply/obtain the CA and accept the risk.
DATABASE_SSL_VERIFY=true

# Optional: path to a PEM root certificate for a private CA
# (for example the provider's documented root certificate).
DATABASE_SSL_CA_PATH=

# Pool and statement limits (milliseconds)
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Read-only connection used exclusively by inspection scripts.
# Optional; the server never reads this variable.
DATABASE_URL_READONLY=

# HTTP behaviour
API_BASE_PATH=/api/v1
LOG_LEVEL=info
BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# CORS: comma-separated origins, or * for any.
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Second switch for data-changing migration commands. Leave disabled.
# `npm run db:migrate` refuses to apply or roll back unless this is true.
ALLOW_MIGRATE=false
