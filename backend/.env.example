# CET Tariff Backend — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

NODE_ENV=development
PORT=3000

# Neon PostgreSQL connection string (write-capable role for normal operation).
# Required. Use sslmode=require and the Neon pooled endpoint.
DATABASE_URL=

# Set to false only for a local non-TLS PostgreSQL instance.
DATABASE_SSL=true

# Pool and statement limits (milliseconds)
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Read-only connection used exclusively by the audit script (scripts/audit).
# Optional; the server never reads this variable.
DATABASE_URL_READONLY=

# HTTP behaviour
API_BASE_PATH=/api/v1
LOG_LEVEL=info
BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# CORS: comma-separated origins, or * for any.
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Second switch for data-changing migration commands. Leave disabled.
# `npm run db:migrate` refuses to apply or roll back unless this is true.
ALLOW_MIGRATE=false
